<div class="page-width">
  <div class="grid">
    <div class="grid__item medium-up--five-sixths medium-up--push-one-twelfth">
      <div class="section-header text-center">
        <h1>{{ page.title }}</h1>
      </div>

      {% if page.handle == 'dvds-used' %}
        <div class="dvds-used-banner">
          <img
            src="{{ 'dvds-used-banner.png' | asset_url }}"
            alt="Bring the Movie Theater into your Home"
            style="width: 100%; height: auto; display: block; margin-bottom: 20px;"
          >
        </div>
      {% endif %}

      <div class="rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>
